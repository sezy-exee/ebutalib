{
  "cleanUrls": true
}
{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lokalnirast.vercel.app"
        }
      ],
      "destination": "https://lokalnirast.store/:path*",
      "permanent": true
    }
  ]
}
